  (text "Battery monitor: BAT_EN high -> Q2 pulls Q1's gate down -> Q1 connects the cell to R51/R52 (half the cell)." (exclude_from_sim no) (at 250 210 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "6ae6fd99-e8b2-4788-af5b-29a32b6dac80"))
  (text "Wait 25 ms, average a few ADC readings, BAT_EN low. Off, the cell sees only the MOSFETs' leakage." (exclude_from_sim no) (at 250 213 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "5894a271-a75b-498e-a1b7-8f84356e419d"))
  (text "R54 holds BAT_EN low while the controller is unpowered or booting; R52 holds the ADC pin at 0 V." (exclude_from_sim no) (at 250 216 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "e6fc096b-9256-4d80-bdd5-a846f1e5a78d"))
